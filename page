            font-size: 15px;
        }
        ul li:before {
            content: "✓ ";
            color: #2ecc71;
            font-weight: bold;
            margin-right: 8px;
        }
        .btn {
            display: inline-block;
            background-color: #2b6cb0;
            color: #ffffff;
            padding: 16px 24px;
            border-radius: 8px;
            font-size: 18px;
            font-weight: bold;
