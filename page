    <!-- 2. GOOGLE ADS EVENT SNIPPET -->
    <!-- This function reports the conversion, then redirects to the profile -->
    <script>
      function gtag_report_conversion(url) {
        var callback = function () {
          if (typeof(url) != 'undefined') {
            window.location = url;
          }
        };
        gtag('event', 'conversion', {
            // Replace AW-XXXXXXXXXX/YYYYYYYYYYYY with your actual Conversion ID and Label
            'send_to': 'AW-XXXXXXXXXX/YYYYYYYYYYYY',
            'event_callback': callback
        });
